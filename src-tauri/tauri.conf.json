{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EPUB Studio",
  "version": "0.1.0",
  "identifier": "com.eastwood.epubstudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "title": "EPUB Studio",
      "width": 1600,
      "height": 980,
      "minWidth": 1200,
      "minHeight": 740,
      "titleBarStyle": "Overlay",
      "hiddenTitle": true
    }],
    "security": { "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
